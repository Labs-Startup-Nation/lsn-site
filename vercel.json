{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^fr.*" }],
      "destination": "/fr/",
      "permanent": false
    },
    { "source": "/", "destination": "/en/", "permanent": false }
  ]
}
