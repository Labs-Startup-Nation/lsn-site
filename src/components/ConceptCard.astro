---
import Beam from './Beam.astro';
import Smoke from './Smoke.astro';
import Label from './Label.astro';
import type { Issue } from '../lib/issue-schema';
import type { Lang } from '../i18n/lang';
import { t } from '../i18n/ui';

interface Props { concept: Issue['concept']; lang: Lang }
const { concept, lang } = Astro.props;
const ul = lang === 'en' ? undefined : lang;
const parts = [
  ['issue.whatItIs', concept.whatItIs],
  ['issue.thinkOfIt', concept.thinkOfIt],
  ['issue.seenThisWeek', concept.seenThisWeek],
  ['issue.inPractice', concept.inPractice],
] as const;
---
<Beam shift={-0.16} class="concept">
  <Smoke class="box">
    <Label lang={ul}>{t(lang, 'issue.conceptOfWeek')}</Label>
    <h3>{concept.name}</h3>
    <dl>
      {parts.map(([key, value]) => <><dt class="label" lang={ul}>{t(lang, key)}</dt><dd class="st">{value}</dd></>)}
    </dl>
  </Smoke>
</Beam>

<style is:global>
  .concept { min-width: 0; }
  .concept > .bc { padding: 20px; }
  .concept .box { margin-top: 72px; padding: 26px; display: flex; flex-direction: column; gap: 6px; }
  .concept h3 { font-family: var(--font-display); font-weight: 600; font-size: 26px; line-height: 1.1; letter-spacing: -.025em; margin: 4px 0 8px; overflow-wrap: anywhere; }
  .concept dl { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .concept dd { margin: 0 0 8px; font-size: 15.5px; }
  @media (max-width: 640px) { .concept > .bc { padding: 12px; } .concept .box { padding: 20px; } }
</style>
