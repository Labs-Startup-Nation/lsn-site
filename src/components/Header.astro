---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import Button from './Button.astro';
import { NAV, isCurrent } from '../lib/nav';
import { localePath, type Lang } from '../i18n/lang';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pathname = Astro.url.pathname;
---
<header class="top">
  <div class="wrap">
    <a class="home" href={localePath(lang, '/')} aria-label={t(lang, 'nav.home')}><Logo tone="ink" /></a>
    <nav class="nav" aria-label={t(lang, 'nav.label')}>
      {NAV.map((item) => (
        <a href={localePath(lang, item.path)} aria-current={isCurrent(pathname, item.path) ? 'page' : undefined}>{t(lang, item.key)}</a>
      ))}
    </nav>
    <Button href={localePath(lang, '/propose')} variant="ink" class="top-cta">{t(lang, 'nav.propose')}</Button>
    <LangSwitch lang={lang} />
  </div>
</header>

<style>
  .top {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }
  .top .wrap { display: flex; align-items: center; gap: 16px; padding-block: 12px; }
  .home { flex: none; height: 26px; display: inline-flex; }
  .nav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; flex: 1; min-width: 0; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a {
    white-space: nowrap; text-decoration: none; font-size: 14.5px; font-weight: 500;
    padding: 8px 12px; border-radius: var(--radius-glass); color: var(--ink-soft);
  }
  .nav a:hover { background: var(--surface-raised); color: var(--ink); }
  .top :global(.top-cta) { flex: none; white-space: nowrap; }
  @media (max-width: 900px) { .top :global(.top-cta) { display: none; } }
  .nav a[aria-current='page'] { color: var(--ink); background: var(--surface-raised); box-shadow: inset 0 -2px 0 var(--ember); }
</style>
