---
interface Props { shift?: number; as?: 'div' | 'article' | 'section'; class?: string; interactive?: boolean }
const { shift = 0, as: Tag = 'div', class: className, interactive = false } = Astro.props;
---
<Tag class:list={['beam', className]} data-shift={shift} data-interactive={interactive ? '' : undefined}>
  <canvas aria-hidden="true"></canvas>
  <div class="bc"><slot /></div>
</Tag>

<script>
  import { initBeams } from '../scripts/beam';
  initBeams();
</script>

<style is:global>
  .beam { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: #FFFBF0; box-shadow: var(--shadow-float); isolation: isolate; }
  .beam > canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
  .beam > .bc { position: relative; z-index: 1; }
  @media print { .beam { box-shadow: none; } }
</style>
