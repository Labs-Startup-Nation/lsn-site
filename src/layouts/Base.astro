---
import '../styles/fonts';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { LANGS, swapLang, type Lang } from '../i18n/lang';
import { t } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string; ogImage?: string }
const { lang, title, description = t(lang, 'site.description'), ogImage = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} · LSN` : `LSN · ${t(lang, 'site.name')}`;
const site = Astro.site ?? new URL('http://localhost:4321');
const abs = (path: string) => new URL(path, site).href;
const pathname = Astro.url.pathname;
// Cookieless Vercel Web Analytics, only where its endpoint exists.
const onVercel = Boolean(process.env.VERCEL);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={abs(pathname)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(swapLang(pathname, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(swapLang(pathname, 'en'))} />
    <link rel="alternate" type="application/rss+xml" title="LSN Tech Watch" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LSN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(pathname)} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {onVercel && <Analytics />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} />
    <main id="main" class="wrap"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip { position: absolute; left: 16px; top: -60px; z-index: 50; background: var(--ink); color: var(--surface); padding: 10px 14px; border-radius: var(--radius-glass); }
  .skip:focus { top: 12px; }
  main { padding-block: 24px 0; min-width: 0; }
</style>
