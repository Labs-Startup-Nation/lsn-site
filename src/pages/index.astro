---
// Root: Vercel redirects by Accept-Language (vercel.json). This page is the fallback
// for other hosts and local preview: it picks the browser language on the client.
import { t } from '../i18n/ui';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LSN · Labs Startup Nation</title>
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="fr" href="/fr/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <script>
      import { pickLang } from '../i18n/lang';
      location.replace(`/${pickLang(navigator.languages ?? [navigator.language])}/`);
    </script>
  </head>
  <body>
    <p><a href="/en/" lang="en">{t('en', 'site.name')} — English</a></p>
    <p><a href="/fr/" lang="fr">{t('fr', 'site.name')} — Français</a></p>
  </body>
</html>
